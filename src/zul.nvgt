        px=p_x[pb]; py=p_y[pb]; last_place=pb; hp=100; cans=10; energy=100;
        script_q={"enter"}; script_i=0; script_done=false; script_mode=true;
        act_sleep(); script_mode=false;
        check("a night on a bench takes something out of you", hp < 100 || energy < 100); } }
