    { // ENERGY is a stamina bar: what you have is what you have, and it comes back
      // from sleeping, from what you eat and drink, and from sitting down. There
      // is NO passive trickle: waiting used to hand you a free point every ten
      // minutes, which quietly undid the whole economy of working to eat.
      new_game_state("tom"); energy = 40; hunger = 20;
      int before = energy;
      pass_time(60);
      check("an hour of doing nothing gives you nothing back", energy == before);
      pass_time(240);
      check("nor does half a day of it", energy == before);
      // but the things that should put you right, do
      bag_food[5] = 1; use_food(5);
      check("a proper meal puts you right", energy > before);
      energy = 40; bag_drink[6] = 1; int b2 = energy; use_drink(6);
      check("a coffee picks you up", energy > b2);
      energy = 40; int b3 = energy; area = "park"; px = 5; py = 4;
      act_sit();
      check("and sitting down a while does too", energy > b3);
      // A BENCH IS NOT A BED. Without a ceiling, sitting would simply become the
      // old free trickle again, six times faster and needing more keypresses.
      energy = 90; int b4 = energy;
      act_sit();
      check("but a bench cannot fill you up when you are already fresh", energy == b4);
      energy = 0;
      for (int r = 0; r < 12; r++) act_sit();
      check("and no amount of sitting gets you past a breather", energy <= 55);
      check("though it always gets you off the floor, so you can never be stuck", energy > 0);
      check("the strong stuff takes it instead of giving it", drink_energy[1] < 0);
      // and a night is what really fixes you
      energy = 0; minutes = 22*60;
      script_q = {"enter"}; script_i=0; script_done=false; script_mode=true;
      act_sleep(); script_mode=false;
      check("a night's sleep is what actually puts you back on your feet", energy >= 30);
      // A BENCH IS NOT A BED. Without a ceiling, sitting would simply become the
      // old trickle again, six times faster and needing more keypresses: twenty
      // minutes for twelve energy, all day, for nothing.
      { new_game_state("tom"); area="park"; px=5; py=4; minutes=13*60;
        energy = 5;
        for (int k=0;k<12;k++) act_sit();
        check("no amount of sitting fills you up", energy < 100);
        check("but it does pull you up off the floor", energy > 5);
        int plateau = energy;
        for (int k=0;k<6;k++) act_sit();
        check("and past that point it stops giving", energy == plateau);
        new_game_state("tom"); }
      // and there is no dead end: broke, empty and worn out, you can still act
      { new_game_state("tom"); energy = 0; money = 0;
        for (uint z=0;z<bag_food.length();z++) bag_food[z]=0;
        area="park"; px=5; py=4;
        act_sit();
        check("with nothing at all you can still sit and get going again", energy > 0);
        new_game_state("tom"); }
      new_game_state("tom"); }
    { // and you can ask how you are holding up
