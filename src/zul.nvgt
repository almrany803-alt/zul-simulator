        { new_game_state("tom"); area="podworko"; minutes=13*60; npc_settle();
          int who = -1;
          for (uint i=0;i<n_area.length();i++)
            if (n_area[i]=="podworko" && npc_on_now(i)) { who = int(i); break; }
          if (who < 0) check("somebody is about to talk to", false);
          else {
          facing_npc = -1; px = n_x[who]-1; py = n_y[who];
          capture_speech = true; spoken_log = "";
          script_q = {"escape","escape","escape"}; script_i=0; script_done=false; script_mode=true;
          do_here();
          script_mode = false; capture_speech = false;
          check("standing beside somebody, Enter talks to them", spoken_log.length() > 15); } }
        // but a place still wins, or Enter at the shop would talk to the shopkeeper
