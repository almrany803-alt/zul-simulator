    // and they walk there rather than teleporting
    { area="podworko"; minutes=7*60; px=1; py=6; npc_settle();     // stand well out of their way
      int pi=-1; for(uint i=0;i<n_area.length();i++) if(n_area[i]=="podworko" && n_who[i]=="pijak" && npc_on_now(i)) pi=int(i);
      // He is not always there at seven, and reading n_x[-1] is how this crashed
