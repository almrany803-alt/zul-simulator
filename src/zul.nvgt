      } }
    check("and it reads back as a real item name", taste_name(npc_disc_love[bi]).length()>2);
      npc_gift_day[bi]=0; bag_food[4]=0; bag_drink[0]=1;
      script_q = {"enter"}; script_i=0; script_done=false; script_mode=true; give_to(wi); script_mode=false;
      check("give someone what they hate and you remember that too", npc_disc_hate[bi]>=0); }
    area="ulica";

    // ---------- EVERY PERSON LOVES SOMETHING DIFFERENT (so guessing means something) ----------
    { // build each character's list of loved things across everything giftable
      bool oneshop=true, onefound=true, unique=true; string clash="";
      for (uint a=0; a<npc_id.length(); a++) {
        int shoploves=0, findloves=0;
        for (uint it=0; it<drink_ids.length(); it++) if (npc_taste(npc_id[a],0,int(it))=="love") shoploves++;
        for (uint it=0; it<food_ids.length(); it++)  if (npc_taste(npc_id[a],1,int(it))=="love") shoploves++;
        if (npc_taste(npc_id[a],2,0)=="love") shoploves++;
        for (uint it=0; it<find_ids.length(); it++) if (npc_taste(npc_id[a],3,int(it))=="love") findloves++;
        if (shoploves!=1) oneshop=false;
        if (findloves!=1) onefound=false;
        // nobody else may love the same thing
        for (uint b=0; b<npc_id.length(); b++) {
          if (a==b) continue;
          for (int k=0; k<4; k++) for (int it=0; it<int(find_ids.length()); it++) {
            if (k==0 && it>=int(drink_ids.length())) continue;
            if (k==1 && it>=int(food_ids.length())) continue;
            if (k==2 && it>0) continue;
            if (npc_taste(npc_id[a],k,it)=="love" && npc_taste(npc_id[b],k,it)=="love") {
              unique=false; if(clash=="") clash=npc_id[a]+" and "+npc_id[b];
            }
          }
        }
      }
      check("everyone loves exactly one thing off the shelf", oneshop);
      check("and exactly one thing you can only find", onefound);
      check("no two people love the same thing" + (clash!="" ? " (clash: "+clash+")" : ""), unique); }
    check("the grandmother wants pierogi and flowers", npc_taste("babcia",1,4)=="love" && npc_taste("babcia",3,1)=="love");
    check("the teenager wants a zapiekanka and football stickers", npc_taste("sklepowy",1,3)=="love" && npc_taste("sklepowy",3,4)=="love");
    check("the old boy wants a vodka and a badge from the old works", npc_taste("stary",0,1)=="love" && npc_taste("stary",3,0)=="love");
    check("the copper secretly wants a kebab, and a wallet handed in", npc_taste("krawezniak",1,5)=="love" && npc_taste("krawezniak",3,7)=="love");

