      snitch_score=0; check("one name does not", !known_snitch()); }
    { // the line: your character will not, unless you make him
      check("he will not raise a hand to any woman without being made to", is_woman("babcia") && is_woman("siostra") && is_woman("matka") && is_woman("kioskarka"));
      check("nor to the schoolgirl, who is a child", is_child("uczennica"));
      check("the old boy is refused outright", fight_refuses("stary"));
      new_game_state("tom"); area="rynek"; minutes=13*60; npc_settle();
      int wi=-1; for(uint i=0;i<n_area.length();i++) if(n_area[i]=="rynek" && n_who[i]=="babcia" && npc_on_now(i)) wi=int(i);
      if (wi>=0) { capture_speech=true; spoken_log="";
