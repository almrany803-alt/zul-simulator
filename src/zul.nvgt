    // ---------- OPTIONS, AUTO-SAVE, DAY COUNTER ----------
    { check("there is an options menu", has_text("opt/title"));
      check("with a drunk-audio toggle", has_text("opt/drunk_on") && has_text("opt/drunk_off"));
      check("and an auto-save toggle", has_text("opt/autosave_on") && has_text("opt/autosave_off"));
      check("auto-save is on by default", auto_save == true); }
    { // auto-save writes a save at day's end when on
      new_game_state("tom"); auto_save=true; in_game=true; day_number=1;
      file rmf; if(rmf.open(save_file(),"rb")){rmf.close(); file df; df.open(save_file(),"wb"); df.write(""); df.close();}
      end_day();
      file sf; bool saved = sf.open(save_file(),"rb"); if(saved){ string d=sf.read(); sf.close(); saved = d.length()>10; }
      check("with auto-save on, the day ending writes a save", saved);
