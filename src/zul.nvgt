               && has_text("sleep/rough_3") && has_text("sleep/bottles_gone") && has_text("sleep/moved_on");
      check("the sleep system has all its words", said); }
    { // THE DISTRICT SOUNDS DIFFERENT AT DIFFERENT HOURS
