        script_q = {"enter"}; script_i=0; script_done=false; script_mode=true; beg_from(wi); script_mode=false;
        if(money>0) wins_good++; }                      // option 1 = humble, which he likes
      for(int r=0;r<60;r++){ money=0; community=50; npc_rel[si]=0; drunk=0;
        script_q = {"down","down","enter"}; script_i=0; script_done=false; script_mode=true; beg_from(wi); script_mode=false;
        if(money>0) wins_bad++; }                       // option 3 = blunt, which he hates
