      check("give someone what they love and you remember it", npc_disc_love[bi] >= 0);
      check("and it is remembered as the thing you actually gave them",
            taste_name(npc_disc_love[bi]) == t("shop/food_" + food_ids[4]));
      // Items were packed as kind*10 + item, which broke the moment a list went
    // past nine long. There are fifteen findable things, so the last five decoded
