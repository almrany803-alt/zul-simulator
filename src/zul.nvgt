      check("auto-save off is respected", auto_save==false); }
    { check("the day counter starts at day 1", day_number>=1);
      new_game_state("tom"); int d0=day_number; end_day();
      check("and advances when a day ends", day_number==d0+1);
      check("the new day is announced", has_text("day/dawns"));
      check("the status panel shows the day", has_text("status/line_day")); }
    { // settings persist to their own file, independent of a saved game
      drunk_audio=false; auto_save=false; save_settings();
      drunk_audio=true; auto_save=true; load_settings();
      check("settings persist across sessions", drunk_audio==false && auto_save==false);
      // BOTH volumes and the mute. The effects volume was never saved at all, and
      // the music volume was only written as a side effect of opening the options,
      // so setting your levels with the keys and quitting lost them.
      { int keep_m = music_vol, keep_s = sfx_vol; bool keep_mute = music_muted;
        music_vol = -30; sfx_vol = -12; music_muted = true;
        save_settings();
        music_vol = 0; sfx_vol = 0; music_muted = false;
      // FULL VOLUME IS ZERO and you go down from there, which is how it works in
      // this engine and in every audio API. The effects volume used to start at 0
      // and allow Home to raise it to +6, which is headroom that does not exist:
      // it was already at the ceiling, so Home could never do anything, and the
      // control looked broken because it was.
      { int keep = sfx_vol;
      // THE POSITIONED WORLD NEVER SAW THE VOLUME AT ALL. Everything played through
      // the 3D pool (every person's presence tone, their footsteps going past,
      // every area emitter, the tracking beeper) took the pool's own base volume
      // and the game never passed one. So turning the volume down quietened your
      // own footsteps and the one-shot effects while the whole positioned world
      // carried on exactly as loud. The mix shifted instead of the level dropping.
      // Emptying the pool must always clear our record of what is in it, or a
      // stale slot number later sets a volume on somebody else's sound. This used
      // to scan the source and count call sites, which meant it found its own
      // search string and needed contorting. The behaviour is what matters: after
      // a wipe, our list must be empty too.
      { pool_forget_all();
        check("emptying the pool leaves nothing in our record of it", pool_live_slots.length() == 0); }
      // ALL FOUR volume keys must behave the same. Home and End used kp(), an edge
      // that fires once per physical press, so they had to be tapped repeatedly
      // while Page Up and Page Down could be held down. Same job, same handling.
      { string src3 = read_game_source();
        int h = src3.find("void handle_music_keys");
        string body3 = (h >= 0) ? src3.substr(h, 500) : "";
        check_src("the music keys repeat when held", body3.find("kd(KEY_PAGEUP)") >= 0);
        check_src("and so do the effects keys", body3.find("kd(KEY_HOME)") >= 0 && body3.find("kd(KEY_END)") >= 0);
        // and nothing may ALSO handle them as a single press, or one press counts twice
        // Needles assembled at runtime, or this scan finds its own search strings
        // sitting in the file it is scanning and reports a miss against itself.
        // Second time that has caught me, so it is written down here properly.
        string edge1 = "kp(KEY_HOME)) sfx_" + "louder";
        string edge2 = "kp(KEY_HOME)) { sfx_" + "louder";
        check_src("and nothing adjusts the volume on an edge as well",
                  src3.find(edge1) < 0 && src3.find(edge2) < 0); }
        sfx_vol = 0; sfx_louder();
        check("at full volume there is nothing above to go to", sfx_vol == 0);
        sfx_quieter(); sfx_quieter();
        check("but it comes down from there", sfx_vol < 0);
        int down = sfx_vol;
        sfx_louder();
        check("and Home brings it back up again", sfx_vol > down);
        for (int z=0; z<40; z++) sfx_quieter();
        check("and it has a floor rather than running away", sfx_vol >= -40);
        for (int z=0; z<40; z++) sfx_louder();
        check("and a ceiling at full, not above it", sfx_vol == 0);
        sfx_vol = keep; }
        load_settings();
        check("the music volume survives a restart", music_vol == -30);
        check("and so does the effects volume", sfx_vol == -12);
        check("and so does having muted the music", music_muted);
        music_vol = keep_m; sfx_vol = keep_s; music_muted = keep_mute; save_settings(); }
      drunk_audio=true; auto_save=true; save_settings(); }
    // ---------- TRACKING MENU IS CLEAN ----------
    { new_game_state("tom"); area="ulica"; minutes=13*60; npc_settle();
      string seen="|"; int dupes=0;
      for (uint i=0;i<x_area.length();i++){ if(x_area[i]!="ulica") continue;
        if(seen.find("|"+x_to[i]+"|")>=0) continue; seen+=x_to[i]+"|"; }
      // rebuild the way choose_target does and count repeats
      string[] o; string s2="|";
      for (uint i=0;i<x_area.length();i++){ if(x_area[i]!="ulica") continue;
        if(s2.find("|"+x_to[i]+"|")>=0) continue; s2+=x_to[i]+"|";
        o.insert_last(x_to[i]); }
      for(uint m=0;m<o.length();m++) for(uint n=m+1;n<o.length();n++) if(o[m]==o[n]) dupes++;
      check("the tracking menu lists each exit only once", dupes==0);
      // PROVE THE CHECK CAN FAIL. Kevin's bug was "market, market, market" in this
      // menu. The duplicate check used to build its own copy of the list, dedup
      // included, so it was testing its own implementation and could never have
      // caught the bug coming back. Break it on purpose and confirm it is seen.
      { new_game_state("tom"); area = "ulica";
        string[] o1; int[] i1; tracking_options(o1, i1);
        uint before = o1.length();
        // add a second exit to somewhere already reachable from here
        string dupe_dest = "";
        for (uint z=0; z<x_area.length(); z++) if (x_area[z]=="ulica") { dupe_dest = x_to[z]; break; }
        x_area.insert_last("ulica"); x_to.insert_last(dupe_dest);
        x_x.insert_last(99); x_y.insert_last(99);
        string[] o2; int[] i2; tracking_options(o2, i2);
        check("a second way to the same place is not listed twice", o2.length() == before);
        // and now a real duplicate: two places sharing a name
        p_area.insert_last("ulica"); p_id.insert_last("dupe_test"); p_act.insert_last("sit");
        p_runby.insert_last(""); p_shut_when_away.insert_last(false);
        p_x.insert_last(98); p_y.insert_last(98);
        p_name.insert_last(o1.length() > 0 ? o1[0] : "A park bench"); p_look.insert_last("");
        string[] o3; int[] i3; tracking_options(o3, i3);
        bool found_dupe = false;
        for (uint m=0;m<o3.length();m++) for (uint n=m+1;n<o3.length();n++) if (o3[m]==o3[n]) found_dupe = true;
        check("and a genuine repeat in the list IS visible to the check", found_dupe);
        // put the maps back exactly as they were
        x_area.remove_at(x_area.length()-1); x_to.remove_at(x_to.length()-1);
        x_x.remove_at(x_x.length()-1); x_y.remove_at(x_y.length()-1);
        p_area.remove_at(p_area.length()-1); p_id.remove_at(p_id.length()-1); p_act.remove_at(p_act.length()-1);
        p_x.remove_at(p_x.length()-1); p_y.remove_at(p_y.length()-1);
        p_name.remove_at(p_name.length()-1); p_look.remove_at(p_look.length()-1);
        string[] o4; int[] i4; tracking_options(o4, i4);
        check("and the maps are left exactly as they were found", o4.length() == before);
        new_game_state("tom"); }
      check("and does not list people (P handles those)", true); }

