    { string src=""; file sf; if (sf.open("zul.nvgt","rb")) { src=sf.read(); sf.close(); }
      check_src("running out of energy is heard, not just read", src.find("sfx_breath(); vspeak(t(\"energy/spent\")")>=0 || src.find("sfx_breath(); vspeak(t(\"energy/too_tired\")")>=0);
      check_src("the low energy warning has a heartbeat on it", src.find("sfx_heartbeat(); vspeak(t(\"energy/low\")")>=0);
      check_src("sitting down makes a sound", src.find("sfx_sit();")>=0);
      check_src("gifts rustle the bag both ways", count_of(src,"sfx_bag();")>=2);
      check_src("the trolley upgrade gets a fanfare, not a coin", src.find("wozek_tier++; sfx_upgrade();")>=0);
      check_src("the mugger taking your money is heard", count_of(src,"sfx_money_grab();")>=3);
      check_src("having no money for something gets a warning tone", count_of(src,"sfx_warn(); vspeak(t(\"shop/no_money\")")>=2); }

    // ---------- A PROPER SCRAP ----------
    { check("the old boy is refused outright", fight_refuses("stary"));
      check("the women and the kid are protected by the line, not by a refusal",
            is_woman("babcia") && is_woman("kioskarka") && is_woman("matka") && is_woman("siostra") && is_child("uczennica"));
      check("but the rival bench is fair game", !fight_refuses("zul_obcy"));
      check("the copper can take far more than a drunk", fight_their_hp("krawezniak") > fight_their_hp("pijak")*3);
      check("the barman has lifted barrels for twenty years", fight_their_hp("barman") > fight_their_hp("kombinator")); }
    { // refusing to fight the untouchables is spoken, not silent
      new_game_state("tom"); area="podworko"; minutes=8*60; npc_settle();
      int oi=-1; for(uint i=0;i<n_area.length();i++) if(n_area[i]=="podworko" && n_who[i]=="stary" && npc_on_now(i)) oi=int(i);
      capture_speech=true; spoken_log=""; fight(oi); capture_speech=false;
      check("your own character talks you out of hitting the old boy", spoken_log.length()>20); }
      // Nothing is charged for a fight that never happens. The quest credit and
      // the police attention used to be handed out before any of the checks, so
      // a refusal, thinking better of it, or being too tired all left you with
      // credit for a scrap you never had and heat for a brawl nobody saw.
      { new_game_state("marcin"); events_on = false;
        area = "podworko"; minutes = 8*60; npc_settle();
        int oldboy = -1;
        for (uint i=0;i<n_area.length();i++)
          if (n_area[i]=="podworko" && n_who[i]=="stary" && npc_on_now(i)) oldboy = int(i);
        if (oldboy >= 0) {
          police_heat = 0; int scrapped = 0;
          for (int q=0;q<NUM_DAILY;q++) if (qpool_type[dq_idx[q]]=="scrap") scrapped = dq_prog[q];
          fight(oldboy);
          check("a fight that is refused draws no police attention", police_heat == 0);
          int after = scrapped;
          for (int q=0;q<NUM_DAILY;q++) if (qpool_type[dq_idx[q]]=="scrap") after = dq_prog[q];
          check("and earns no credit for a scrap that never happened", after == scrapped);
        }
        // too tired to fight is the same: nothing happened, so nothing counts
        int rival = -1;
        area = "park"; minutes = 13*60; npc_settle();
        for (uint i=0;i<n_area.length();i++)
          if (n_area[i]=="park" && n_who[i]=="zul_obcy" && npc_on_now(i)) rival = int(i);
        if (rival >= 0) {
          energy = 2; police_heat = 0;
          fight(rival);
          check("nor does being too worn out to throw a punch", police_heat == 0);
        }
        new_game_state("marcin"); }
    { // too knackered to fight
      new_game_state("tom"); area="podworko"; minutes=8*60; npc_settle(); energy=0;
      int pi=-1; for(uint i=0;i<n_area.length();i++) if(n_area[i]=="podworko" && n_who[i]=="pijak" && npc_on_now(i)) pi=int(i);
      capture_speech=true; spoken_log=""; fight(pi); capture_speech=false;
      check("you cannot start a scrap with nothing left in you", spoken_log.length()>15); energy=100; }
    { // a full scrap: swing until somebody drops
      new_game_state("marcin"); area="podworko"; minutes=8*60; npc_settle();
      street=90; hp=100; energy=100; money=50; events_on=false;
      int pi=-1; for(uint i=0;i<n_area.length();i++) if(n_area[i]=="podworko" && n_who[i]=="pijak" && npc_on_now(i)) pi=int(i);
      int rel0=npc_rel[npc_index("pijak")]; int st0=street;
      string[] q; for(int r=0;r<60;r++) q.insert_last("enter");     // keep swinging
