    { // running the tests must NEVER touch a real saved game or real settings
      string marker = "PLAYER_SAVE_DO_NOT_TOUCH";
      bool had_save = false, had_set = false; string old_save = "", old_set = "";
      { file pf; if (pf.open(real_save_file(),"rb")) { had_save = true; old_save = pf.read(); pf.close(); } }
      { file gf; if (gf.open(real_settings_file(),"rb")) { had_set = true; old_set = gf.read(); gf.close(); } }
      { file pf; if (pf.open(real_save_file(),"wb")) { pf.write(marker); pf.close(); } }
      { file gf; if (gf.open(real_settings_file(),"wb")) { gf.write(marker); gf.close(); } }
      new_game_state("tom"); in_game=true; auto_save=true;
      save_game(); save_settings(); end_day();                 // all of these would have clobbered it before
      string after = "", after_set = "";
      { file pf; if (pf.open(real_save_file(),"rb")) { after = pf.read(); pf.close(); } }
      { file gf; if (gf.open(real_settings_file(),"rb")) { after_set = gf.read(); gf.close(); } }
      check("a test run leaves the player's saved game alone", after == marker);
      check("a test run leaves the player's settings alone", after_set == marker);
      { file tf; bool wrote = tf.open(game_data_dir() + "save_test.dat","rb"); if (wrote) tf.close();
        check("the tests save to their own scratch file instead", wrote); }
      if (had_save) { file pf; if (pf.open(real_save_file(),"wb")) { pf.write(old_save); pf.close(); } }
      else file_delete(real_save_file());
      if (had_set) { file gf; if (gf.open(real_settings_file(),"wb")) { gf.write(old_set); gf.close(); } }
      else file_delete(real_settings_file());
      { file pf; bool still = pf.open(real_save_file(),"rb"); if (still) pf.close();
        check("testing leaves no saved game behind on a clean install", had_save || !still); } }
    { // the shared log must BUILD UP over runs, never wipe what came before, and
      // it must be written AS THE RUN HAPPENS so a run that freezes still
      // leaves a tester something to send on.
      // NOTE: this uses its own scratch file. An earlier version checked the
      // REAL log and wiped it to start clean, which destroyed the header and
      // every result written before this point. A test must never destroy the
      // evidence of the run it belongs to.
      string probe = "log_check_scratch.txt";
      { file d; if (d.open(probe,"wb")) { d.write("OLDER RUN MARKER\n"); d.close(); } }
      { file w; if (w.open(probe,"ab")) {
          w.write("\n================================================================\n");
          w.write("TEST RUN     " + stamp() + "\n");
          w.write("game version : " + GAME_VERSION + "\n");
          w.write("(written before the run begins, so if the run freezes\n");
          w.write(" everything up to the freeze is still here to send on)\n");
          w.write("a line written while the run was still going\n");
          w.write("SUMMARY OF THE RUN ABOVE, finished " + stamp() + "\n");
          w.write("---- end of this run ----\n");
          w.close(); } }
      string h = ""; { file r; if (r.open(probe,"rb")) { h = r.read(); r.close(); } }
      check("the log keeps what was already there", h.find("OLDER RUN MARKER") >= 0);
      check("the log says when the run started, before it has finished", h.find("TEST RUN") >= 0);
      check("the log records which version was tested", h.find(GAME_VERSION) >= 0);
      check("lines are written as the run happens, not only at the end",
            h.find("a line written while the run was still going") >= 0);
      check("the log warns that a frozen run still leaves its evidence", h.find("freezes") >= 0);
      check("the log sums up the run afterwards", h.find("SUMMARY OF THE RUN") >= 0);
      check("the log marks where each run ends", h.find("end of this run") >= 0);
      file_delete(probe);
      // and the REAL log must still be intact right now, with this run in it
      string live = ""; { file r; if (r.open("zul_test_log.txt","rb")) { live = r.read(); r.close(); } }
      check("this very run is being written to the log as it goes", live.find("TEST RUN") >= 0);
      check("the log has not been wiped by the tests themselves", live.length() > 1000); }
    { // THE "HOW MANY DAYS" OPTION, driven rather than read. Mohammed could not
      // find it, so this checks it is really on the menu, that arrowing down
      // reaches it, and that picking a number CHANGES something rather than
      // just saying it did.
      int keep_days = persona_days;
      check("the menu offers a choice of how many days", has_text("test/days") && has_text("test/days_ask"));
      check("every length on offer has words", has_text("test/days_1") && has_text("test/days_2")
            && has_text("test/days_3") && has_text("test/days_5") && has_text("test/days_10"));
      // The days question is no longer a setting in the menu: it is asked when
      // you pick a run that actually uses the playtesters, which is where it
      // means something. So this drives that flow instead.
      // The days question is asked when you pick a run that uses the
      // playtesters, rather than sitting in the menu as a setting nobody found.
      persona_days = 2;
      int t_two = 20 + persona_days * 25;
      persona_days = 10;
      int t_ten = 20 + persona_days * 25;
      check("asking for more days really does give them longer", t_ten > t_two);
      persona_days = 2;
      persona_days = 3; int turns_three = 20 + persona_days * 25;
      persona_days = 10; int turns_ten = 20 + persona_days * 25;
      check("asking for more days gives the playtesters more time", turns_ten > turns_three);
      persona_days = keep_days; test_running = false; }
    { // SLEEP. It asks first, and where you sleep matters.
      new_game_state("tom"); area="ulica"; int bi=place_index("ulica","blok");
      px=p_x[bi]; py=p_y[bi]; last_place=bi; int d0=day_number;
      script_q={"escape"}; script_i=0; script_done=false; script_mode=true;
      act_sleep(); script_mode=false;
      check("walking away from the question does not end your day", day_number==d0);
      script_q={"enter"}; script_i=0; script_done=false; script_mode=true;
      int snore_before = rb_sound_calls;
      act_sleep(); script_mode=false;
      check("saying yes in your own bed ends the day", day_number==d0+1);
      check("your own bed is not sleeping rough", energy > 50);
      // Judged by WHERE YOU ARE, not by where the game last announced you were.
      // An arrest, the sobering station and passing out all put you at your own
      // block without walking there and reset the announcement marker, so the
      // next thing you did, going to bed, was punished as kipping rough.
      { new_game_state("tom"); area = "ulica";
        int bk2 = place_index("ulica","blok");
        px = p_x[bk2]; py = p_y[bk2];
        last_place = -2;                       // exactly as passout leaves it
        check("your own bed is your own bed even if you did not walk to it",
              !sleeping_rough());
        // and a bench really is rough
        area = "park"; px = 6; py = 7; last_place = -2;
        check("a bench under the trees is still sleeping rough", sleeping_rough());
        new_game_state("tom"); }
      check("sleeping plays a snore you can hear", rb_sound_calls > snore_before); }
    { // a night outside costs you something
