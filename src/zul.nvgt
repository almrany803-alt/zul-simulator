      bag_drink[1]=2; int r0=npc_rel[npc_index("stary")];
      script_q = {"enter"}; script_i=0; script_done=false; script_mode=true; give_to(wi); script_mode=false;
      check("giving someone what they love lifts their opinion of you", npc_rel[npc_index("stary")] > r0);
      int r1=npc_rel[npc_index("stary")];
      capture_speech=true; spoken_log=""; give_to(wi); capture_speech=false;
