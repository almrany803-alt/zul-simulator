      for(uint i=0;i<need.length();i++){ file pf; if(!pf.open("sounds/"+need[i]+".ogg","rb")) ok=false; else pf.close(); }
      check("siren, cuffs, cell, whistle and the rest are all real files", ok); }
    new_game_state("tom"); area="ulica"; minutes=8*60; events_on=false; marked_days=0; snitch_score=0;

    // ---------- THE CELLS, AND VISITING ----------
    { new_game_state("tom"); events_on=false;
      check("nobody is inside when you start", !anyone_inside());
      jail_npc("kombinator", true);
      int ki=npc_index("kombinator");
      check("grassing somebody puts them inside", npc_jailed[ki] > 0);
      check("and the game remembers it was your doing", npc_jailed_by_you[ki]==1);
      // they vanish from the world while they are in there
      area="rynek"; minutes=13*60; npc_settle();
      bool visible=false;
      for(uint i=0;i<n_area.length();i++) if(n_who[i]=="kombinator" && npc_on_now(i)) visible=true;
      check("somebody inside is not out on the street", !visible);
      // they come back out. "Forever" is impossible for two mechanical reasons,
      // and we assert BOTH directly rather than playing days out (a playthrough
      // is noisy: release and the 12% empty-cell re-jail happen inside the same
      // end_day(), so a jailed counter can read non-zero even the day he leaves).
      //  (1) a sentence is always FINITE: jail_npc sets 2 + random(1,3) = 3..5 days
      check("a sentence is always a finite 3 to 5 days", npc_jailed[ki] >= 3 && npc_jailed[ki] <= 5);
      //  (2) a positive counter ALWAYS drops by exactly one each day. Freshly jailed
      //      he is at 3..5, so one end_day leaves him at 2..4, still inside: the cell
      //      is never empty here, so the re-jail cannot fire and this step is exact.
      int before = npc_jailed[ki];
      end_day();
      check("every day inside counts down by exactly one", npc_jailed[ki] == before - 1);
      // A NIGHT IN CUSTODY USED TO SKIP EVERY OVERNIGHT THING. Neither an arrest nor
      // the sobering station called end_day, so the day advanced while nothing
      // that happens overnight happened: tasks were never refreshed, sentences
      // never counted down, being marked never wore off, habits never eased.
      { new_game_state("tom"); money = 40; drunk = 0;
        jail_npc("pijak", true);
        int pj = npc_index("pijak");
        // A long sentence on purpose. With a short one, several nights inside can
        // run it out, and then the overnight pass has a one-in-eight chance of
        // somebody new being picked up, which can be the same man with a fresh
        // longer stretch. That is the game behaving correctly and the test being
        // too strict, and it made this fail perhaps one run in ten.
        npc_jailed[pj] = 9;
        int sentence_before = npc_jailed[pj];
        marked_days = 4; booze_habit = 50;
        dq_prog[0] = 999; dq_done[0] = true;              // yesterday's task, already finished
        arrest("nuisance");
        check("a night inside counts towards somebody else's sentence", npc_jailed[pj] < sentence_before);
        check("and being marked wears off while you are in there", marked_days < 4);
        check("and the habit eases, since there is nothing to feed it", booze_habit < 50);
        check("and you wake to a fresh set of tasks, not yesterday's", !dq_done[0]);
        // The habit must not be counted twice. custody_night takes the usual 3 a
        // night; the cell adds only the 1 extra for being locked away from it.
        { new_game_state("tom"); booze_habit = 90; fag_habit = 90;
          cell_reset(); cell_reason = "nuisance"; cell_confiscated = 0;
          cell_extra_days = 0;
          int bh = booze_habit;
          cell_morning_reckoning(); custody_night(1);
          check("one night inside eases the habit by about a night's worth",
                bh - booze_habit >= 3 && bh - booze_habit <= 5);
          new_game_state("tom"); }
        new_game_state("tom"); }
      //  finite start + guaranteed -1 per day => the counter must reach 0. Release is
      //  therefore certain; nobody is ever trapped. (Re-jail after release is a fresh,
      //  independent finite sentence, not a continuation, so it cannot trap either.)
      check("nobody can be held forever", npc_jailed[ki] < before); }
