      check("it tells you what money you have", spoken_log.find("37")>=0);
      check("and how you are holding up", spoken_log.find("64")>=0 || spoken_log.length()>80); }
    minutes=8*60;

    // ---------- THE INVENTORY (I) ----------
    { new_game_state("marcin"); area="ulica"; money=200;
      for(uint c1=0;c1<bag_drink.length();c1++) bag_drink[c1]=0;
      for(uint c2=0;c2<bag_food.length();c2++) bag_food[c2]=0;
      for(uint c3=0;c3<bag_find.length();c3++) bag_find[c3]=0;
      fags=0; lighter=0;
      capture_speech=true; spoken_log="";
      script_q = {"escape"}; script_i=0; script_done=false; script_mode=true; inventory_report(); script_mode=false;
      check("an empty bag says so rather than staying silent", spoken_log.length()>10);
      bag_drink[1]=2; bag_food[4]=1; bag_find[1]=1; fags=3; lighter=20;
      spoken_log="";
      script_q = {"down","down","down","down","escape"}; script_i=0; script_done=false; script_mode=true;
      inventory_report(); script_mode=false; capture_speech=false;
      check("the inventory lists what you are carrying", spoken_log.length()>40);
      // A SCREEN MUST NAME THE KEYS IT ANSWERS TO. The bag responds to Enter (which
      // eats or drinks the thing you have picked, its whole purpose) and to Home
      // and End, and its title mentioned neither.
      // These used to demand the bag title RECITE ITS CONTROLS, which is the
      // opposite of what it should do: a title heard hundreds of times must not
      // read the keys out at somebody who learned them in their first hour. The
      // how to play is where keys are explained, and that is what is checked now.
      check("the guide explains that Enter uses what is in your bag",
            t("howto/keys_2").find("Enter in there") >= 0);
      check("and the bag title stays short", t("inv/title").length() < 90);
      check("and still says how to close it", t("inv/title").find("Escape") >= 0);
      check("it counts how many you have of a thing", spoken_log.find("2")>=0);
      check("things you found show up in the bag too", spoken_log.find(t("find/flowers"))>=0); }
    { // and using something out of the bag actually consumes it
      new_game_state("marcin"); bag_food[0]=1; hp=50; int hp0=hp;
      use_food(0);
      check("eating out of your bag uses the item up", bag_food[0]==0);
      check("and it does you some good", hp>hp0); }

    // ---------- PEOPLE LOOK AFTER YOU ONCE THEY LIKE YOU ----------
    { new_game_state("tom"); events_on=false; day_number=60;
      for(uint g=0;g<npc_give_day.length();g++) npc_give_day[g]=0;
      int si=npc_index("stary");
      // a stranger gives you nothing, however many times you talk to them
      npc_rel[si]=0; int before=total_carried();
      for(int r=0;r<80;r++){ npc_give_day[si]=0; npc_maybe_gives("stary"); }
      check("a stranger does not start handing you things", total_carried()==before);
      // a proper mate does
      npc_rel[si]=90;
      for(int r=0;r<80;r++){ npc_give_day[si]=0; npc_maybe_gives("stary"); }
      check("somebody who thinks well of you starts looking after you", total_carried()>before); }
    { // and only once a day each
      new_game_state("tom"); day_number=61;
      int bi=npc_index("babcia"); npc_rel[bi]=100;
      for(uint g=0;g<npc_give_day.length();g++) npc_give_day[g]=0;
      int fed=0;
      for(int r=0;r<200;r++){ int had=bag_food[4]+bag_food[0]; npc_maybe_gives("babcia");
                              if(bag_food[4]+bag_food[0]>had) fed++; }
      check("nobody feeds you more than once in a day", fed<=1); }
    { // what they hand over suits who they are
      new_game_state("tom"); day_number=62;
      int bi=npc_index("babcia"); npc_rel[bi]=100;
      int got=0;
      for(int r=0;r<300 && got==0;r++){ npc_give_day[bi]=0; npc_maybe_gives("babcia");
                                        got=bag_food[4]+bag_food[0]; }
      int booze=0; for(uint d=0;d<bag_drink.length();d++) if(drink_drunk[d]>0) booze+=bag_drink[d]+open_drink[d];
      check("the grandmother feeds you rather than getting you drunk", got>0 && booze==0);
      int ki=npc_index("kombinator"); npc_rel[ki]=100;
      int smokes=0;
      for(int r=0;r<300 && smokes==0;r++){ npc_give_day[ki]=0; npc_maybe_gives("kombinator");
                                           smokes=fags+bag_find[2]; }
      check("the schemer sorts you out with smokes or something to sell", smokes>0); }
    { // it lands in your bag properly, and you are told
      new_game_state("tom"); day_number=63;
      int pi=npc_index("pijak"); npc_rel[pi]=100;
      capture_speech=true; spoken_log="";
      for(int r=0;r<300;r++){ npc_give_day[pi]=0; npc_maybe_gives("pijak");
                              if(spoken_log.length()>10) break; }
      capture_speech=false;
      check("you are told when somebody gives you something", spoken_log.length()>10);
      int carrying=0; for(uint d=0;d<bag_drink.length();d++) carrying+=bag_drink[d];
      check("and it actually goes in your bag", carrying>0); }
    { bool everyone=true;                       // nobody is left with nothing to offer
      for(uint i=0;i<npc_id.length();i++){
        new_game_state("tom"); day_number=70+int(i);
        int ni=npc_index(npc_id[i]); npc_rel[ni]=100;
        int total=0;
        for(int r=0;r<400 && total==0;r++){ npc_give_day[ni]=0; npc_maybe_gives(npc_id[i]);
          total=fags; for(uint d=0;d<bag_drink.length();d++) total+=bag_drink[d];
          for(uint fo=0;fo<bag_food.length();fo++) total+=bag_food[fo];
          for(uint fn=0;fn<bag_find.length();fn++) total+=bag_find[fn]; }
        if(total==0) everyone=false; }
      check("every one of them has something to give a mate", everyone); }
    new_game_state("tom"); events_on=false; area="ulica"; minutes=8*60;

    // ---------- SIPPING, AND WHAT HAPPENS IF YOU KEEP GOING ----------
    { new_game_state("tom"); sip_fast_override=false; sip_run=0; sip_last=-1;
      check("every drink says how many mouthfuls are in it", drink_measures.length()==drink_ids.length());
      check("every food says how many bites it takes", food_bites.length()==food_ids.length());
      check("cheap fruit wine lasts longest, which is why it is the staple", drink_measures[2] > drink_measures[1]);
      check("moonshine is four and you are done", drink_measures[5] <= 4);
      check("a mouthful of moonshine hits far harder than a mouthful of lager", drink_drunk[5] > drink_drunk[0]*3);
      check("tea and coffee put energy back rather than taking it", drink_energy[7] > 0 && drink_energy[6] > 0);
      check("drink takes your energy rather than giving you any", drink_energy[1] < 0 && drink_energy[5] < 0); }
    { // a bottle stays half drunk in your bag
      new_game_state("tom"); sip_fast_override=false; sip_run=0; sip_last=-1;
      bag_drink[2]=1; use_drink(2);
      check("starting a bottle takes it out of the bag and opens it", bag_drink[2]==0 && open_drink[2]==drink_measures[2]-1);
      int half = open_drink[2];
      check("and it is still there waiting for you", half > 0);
      for(int s=0;s<half;s++) use_drink(2);
      check("until you finish it off", open_drink[2]==0);
      check("and then there is nothing left to drink", !use_drink(2)); }
    { // keep pressing quickly and it stops being sipping
      new_game_state("tom"); sip_run=0; sip_last=-1;
      bag_drink[2]=1; sip_fast_override=false; use_drink(2);
