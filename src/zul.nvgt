      new_game_state("tom"); area="bar"; money=200; npc_rel[bi]=70;
      script_q={"enter","escape"}; script_i=0; script_done=false; script_mode=true; act_bar(); script_mode=false;
      check("the first one is on him once you are a regular", 200-money < paidfull); }
