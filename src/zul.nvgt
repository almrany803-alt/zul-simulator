      int wi=-1;
      string[] tryareas={"rynek","ulica","podworko","park"};
      for (uint aa=0; aa<tryareas.length() && wi<0; aa++) {
        area=tryareas[aa]; minutes=13*60; npc_settle();
        for(uint i=0;i<n_area.length();i++) if(n_area[i]==area && is_woman(n_who[i]) && npc_on_now(i)) { wi=int(i); break; }
      }
      if (wi>=0) { street=80; community=80;
        script_q={"down","enter"}; script_i=0; script_done=false; script_mode=true; fight(wi); script_mode=false;
        check("the whole town turns on you", community==0 && street==0);
        check("even the roughest lads want nothing to do with it", npc_rel[0]<=-100+5);
        check("and you are marked for days", marked_days>0); } }
      // The counter staff heard too. They will still serve you, because your money
