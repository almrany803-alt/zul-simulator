      sip_fast_override=true;                       // pressing Enter again straight away
      use_drink(2); use_drink(2);                   // the third press is a proper swig
      check("hammering Enter turns sipping into knocking it back", drunk > afterOne*3);
      check("and it takes more out of the bottle", open_drink[2] <= drink_measures[2]-5); }
    { // the game explains it the first time rather than hiding it
      new_game_state("tom"); taught_gulping=false; sip_run=0; sip_last=-1;
      bag_drink[5]=1; sip_fast_override=true;
      capture_speech=true; spoken_log="";
      use_drink(5); use_drink(5); use_drink(5);
      capture_speech=false;
      check("you are told what you are doing to yourself", spoken_log.find("sipping")>=0 || taught_gulping); }
    { // and knocking back something strong hurts
      new_game_state("tom"); sip_run=0; sip_last=-1; hp=100;
      bag_drink[5]=1; sip_fast_override=true;
      use_drink(5); use_drink(5); use_drink(5);
      check("throwing moonshine down your neck costs you health", hp < 100); }
    { // food works the same way
      new_game_state("tom"); sip_run=0; sip_last=-1; sip_fast_override=false;
      bag_food[5]=1; hunger=100; use_food(5);
      check("a kebab is five bites, not one", open_food[5]==4 && bag_food[5]==0);
      check("and one bite only does a fifth of the job", hunger>80);
      for(int bt=0;bt<4;bt++) use_food(5);
      check("finishing it does the rest", open_food[5]==0 && hunger<=40); }
    sip_fast_override=false; sip_run=0; sip_last=-1;

    // ---------- SHOPS ARE PEOPLE, NOT VENDING MACHINES ----------
    { check("there is somebody behind the bar", npc_index("barman")>=0);
