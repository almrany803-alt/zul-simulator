    // ---------- YOU LEARN TASTES BY TRYING ----------
    { for(uint d=0;d<npc_disc_love.length();d++){ npc_disc_love[d]=-1; npc_disc_hate[d]=-1; }
      day_number=20; for(uint g=0;g<npc_gift_day.length();g++) npc_gift_day[g]=0;
      for(uint c1=0;c1<bag_drink.length();c1++) bag_drink[c1]=0;
