    area="ulica";

    // ---------- EVERY CHARACTER LOVES SOMETHING DIFFERENT ----------
    { string[] loves; bool allhaveone=true;
      for (uint n=0;n<npc_id.length();n++) {
        string found=""; int count=0;
        for (int k=0;k<3;k++) {
          int lim = (k==2) ? 1 : (k==0 ? int(drink_ids.length()) : int(food_ids.length()));
          for (int it=0;it<lim;it++) if (npc_taste(npc_id[n],k,it)=="love") { count++; found=""+k+it; }
        }
        if (count!=1) allhaveone=false;
        loves.insert_last(found);
      }
      check("every character loves exactly one thing", allhaveone);
      bool unique=true;
      for (uint a=0;a<loves.length();a++) for (uint b=0;b<loves.length();b++)
        if (a!=b && loves[a]==loves[b]) unique=false;
      check("no two characters love the same thing, so you have to guess", unique); }
    check("the babcia wants pierogi, not a drink", npc_taste("babcia",1,4)=="love" && npc_taste("babcia",0,1)=="hate");
    check("the old boy wants a vodka", npc_taste("stary",0,1)=="love");
    check("the drunk wants the moonshine", npc_taste("pijak",0,5)=="love");
    check("the copper secretly wants a kebab", npc_taste("krawezniak",1,5)=="love");
    check("and the copper still hates anything you drink", npc_taste("krawezniak",0,0)=="hate");
    { int wrong=0; for (uint n=0;n<npc_id.length();n++)
